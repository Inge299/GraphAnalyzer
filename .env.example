# Database Configuration
DATABASE_URL=postgresql+asyncpg://osint_user:osint_password@localhost:5432/osint_db
POSTGRES_USER=osint_user
POSTGRES_PASSWORD=osint_password
POSTGRES_DB=osint_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Application Settings
SECRET_KEY=your-secret-key-here-change-in-production
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5000"]

# Celery Settings
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# File Upload Settings
MAX_UPLOAD_SIZE=10485760  # 10MB

# Inference Service Settings
INFERENCE_URL=http://localhost:8001
INFERENCE_TIMEOUT_SECONDS=60
INFERENCE_EMBEDDING_MODEL=BAAI/bge-m3
INFERENCE_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# LLM Service (OpenAI-compatible API, e.g. LM Studio)
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_API_KEY=lm-studio
LLM_TIMEOUT_SECONDS=120
LLM_MAX_CONTEXT_CHARS=24000
LLM_MODEL_ANALYZE=google/gemma-3-4b
LLM_MODEL_DRAFT=qwen2.5-7b-instruct
LLM_MODEL_EDIT=saiga_gemma2_9b
LLM_RUNTIME_LABEL=
LLM_TEMPERATURE_ANALYZE=0.1
LLM_TEMPERATURE_DRAFT=0.3
LLM_TEMPERATURE_EDIT=0.2

# SNI traffic service
SNI_SERVICE_URL=http://localhost:8012
SNI_TIMEOUT_SECONDS=900
SNI_MAX_CHRONOLOGY_ROWS=20000
SNI_DEFAULT_TOP_N=25
SNI_MAX_INPUT_ROWS=2500000
SNI_REFS_DIR=/app/data/sni/current
SNI_PROFILE_ENABLED=0
SNI_PROFILE_OUTPUT=/tmp/sni_profile.txt
SNI1_SERVICE_URL=http://localhost:8013
SNI1_TIMEOUT_SECONDS=900
SNI1_REFS_DIR=/app/data/sni/current

