# Closed-contour pilot deployment. Copy to .env.closed and set internal URLs.
NODEX_PORT=8080
POSTGRES_USER=osint_user
POSTGRES_PASSWORD=osint_password
POSTGRES_DB=osint_db
SECRET_KEY=nodex-test-secret

# Existing internal Nominatim instance. The endpoint must expose /search.
GEOCODER_ENABLED=true
GEOCODER_BASE_URL=http://192.168.4.12:8080
GEOCODER_USER_AGENT=Nodex/1.0

# Nominatim is not a tile server. Point MapLibre to the internal PMTiles file and fonts.
MAP_MODE=local
MAP_PMTILES_URL=http://192.168.4.12/maps/russia.pmtiles
MAP_GLYPHS_URL=http://192.168.4.12/fonts/{fontstack}/{range}.pbf
# Optional complete MapLibre Style JSON, if supplied later.
MAP_STYLE_URL=
